<Window x:Class="T2MI_Extractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:T2MI_Extractor" xmlns:wpf="clr-namespace:ConsoleControl.WPF;assembly=ConsoleControl.WPF"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="T2MI Analyzer" Height="700" Width="730">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Grid.ColumnSpan="2" FontSize="30" FontWeight="Bold" Foreground="CornflowerBlue" FontFamily="Consolas">T2MI Analyzer</TextBlock>
        <Image Source="C:\Users\admin.genci\Desktop\logotbs.png" Grid.Column="3" Grid.Row="1" Margin="270,0,0,0" Stretch="None"></Image>
        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Grid.ColumnSpan="3" FontSize="20">Search for T2MI encapsulated .ts file</TextBlock>
        <Button x:Name="btn_browse" Margin="90,0,0,20" Click="btn_browse_Click" Grid.Column="1" Grid.Row="3" MaxWidth="100" Content="Browse" FontSize="13"></Button>
        <TextBox x:Name="txt_destination" Margin="0,0,0,20" Grid.Row="3" Grid.Column="2" FontWeight="Black" Grid.ColumnSpan="2" MaxWidth="400"></TextBox>
        <Label Grid.Row="4" Margin="90,0,0,20" Grid.Column="1" FontSize="13" FontWeight="Bold">Add PID</Label>
        <TextBox Grid.Row="4" Margin="0,0,0,20" Grid.Column="2" MaxWidth="50"></TextBox>
        <Button x:Name="btn_extract" Margin="0,0,0,20" Click="btn_extract_Click" Grid.Row="4" Grid.Column="3" MaxWidth="110" Content="Extract Content" FontWeight="Bold" FontSize="14"></Button>
        <Button x:Name="btn_analyzer" Margin="0,0,0,10" Click="btn_analyzer_Click" Grid.Row="5" Grid.Column="1" Content="Analyze TS" MaxWidth="100">
        </Button>
        <Button x:Name="btn_play" Margin="0,0,0,10" Click="btn_play_Click" Content="-Play-" FontSize="14"  Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" MaxWidth="110"></Button>
        <RichTextBox x:Name="Console1" Background="Black" Grid.Column="1" Grid.Row="6" Grid.ColumnSpan="3" Foreground="#FF6CF110">
        </RichTextBox>
    </Grid>
</Window>
